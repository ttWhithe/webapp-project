# ---- App ----
APP_NAME=Genshin Progress Tracker
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ---- Postgres ----
POSTGRES_USER=gpt
POSTGRES_PASSWORD=gpt_secret
POSTGRES_DB=gpt_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gpt:gpt_secret@postgres:5432/gpt_tracker
TEST_DATABASE_URL=postgresql+asyncpg://gpt:gpt_secret@postgres:5432/gpt_tracker_test

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- OAuth: Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# ---- OAuth: Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Payments: Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Payments: YooKassa ----
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---- Catalog ----
GENSHIN_DEV_API_BASE=https://genshin.dev/api
CATALOG_CACHE_TTL=86400

# ---- Catalog API ----
GENSHIN_DB_API_BASE=https://genshin-db-api.vercel.app/api/v5
GENSHIN_DB_API_TIMEOUT=30
GENSHIN_DB_API_CONCURRENCY=5

CATALOG_CACHE_TTL=86400

# ---- Payments: Stripe ----
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
